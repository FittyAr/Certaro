<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ElectroObraApp"
             xmlns:loc="using:ElectroObraApp.Markup"
             xmlns:conv="using:ElectroObraApp.Views.Converters"
             xmlns:controls="clr-namespace:ElectroObraApp.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="ElectroObraApp.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ElectroObraApp/Styles/Palette.axaml" />
                <ResourceInclude Source="avares://ElectroObraApp/Styles/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:PageSizeConverter x:Key="PageSizeConverter" />
            <conv:StringEqualsConverter x:Key="StringEqualsConverter" />
            <conv:EstadoTrabajoToStatusKindConverter x:Key="EstadoTrabajoToStatusKindConverter" />
            <conv:EstadoTrabajoDisplayConverter x:Key="EstadoTrabajoDisplayConverter" />
            <conv:EstadoObraToStatusKindConverter x:Key="EstadoObraToStatusKindConverter" />
            <conv:EstadoObraDisplayConverter x:Key="EstadoObraDisplayConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://ElectroObraApp/Styles/Tokens.axaml"/>
        <StyleInclude Source="avares://ElectroObraApp/Styles/Components.axaml"/>
        <StyleInclude Source="avares://ElectroObraApp/Styles/Controls.axaml"/>
        <materialIcons:MaterialIconStyles />
    </Application.Styles>
</Application>
