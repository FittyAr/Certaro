<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <!-- Spacing scale -->
        <x:Double x:Key="Space4">4</x:Double>
        <x:Double x:Key="Space8">8</x:Double>
        <x:Double x:Key="Space12">12</x:Double>
        <x:Double x:Key="Space16">16</x:Double>
        <x:Double x:Key="Space24">24</x:Double>
        <x:Double x:Key="Space32">32</x:Double>
        <x:Double x:Key="Space48">48</x:Double>

        <Thickness x:Key="Padding4">4</Thickness>
        <Thickness x:Key="Padding8">8</Thickness>
        <Thickness x:Key="Padding12">12</Thickness>
        <Thickness x:Key="Padding16">16</Thickness>
        <Thickness x:Key="Padding24">24</Thickness>
        <Thickness x:Key="Padding32">32</Thickness>
        <Thickness x:Key="Padding48">48</Thickness>

        <!-- Corner radii -->
        <CornerRadius x:Key="Radius4">4</CornerRadius>
        <CornerRadius x:Key="Radius6">6</CornerRadius>
        <CornerRadius x:Key="Radius8">8</CornerRadius>
        <CornerRadius x:Key="Radius12">12</CornerRadius>

        <!-- Elevation shadows (quiet for WASM) -->
        <BoxShadows x:Key="Elevation1">0 1 2 0 #0A000000</BoxShadows>
        <BoxShadows x:Key="Elevation2">0 2 6 0 #12000000</BoxShadows>
        <BoxShadows x:Key="Elevation3">0 4 12 0 #18000000</BoxShadows>

        <SolidColorBrush x:Key="ElevationTint1" Color="#0A000000" />
        <SolidColorBrush x:Key="ElevationTint2" Color="#12000000" />
        <SolidColorBrush x:Key="ElevationTint3" Color="#18000000" />

        <!-- Typography: IBM Plex stack (web loads via index.html; desktop falls back) -->
        <FontFamily x:Key="FontFamilyUi">avares://Avalonia.Fonts.Inter/Assets#Inter, Segoe UI, sans-serif</FontFamily>
        <FontFamily x:Key="FontFamilyMono">Consolas, Cascadia Mono, IBM Plex Mono, monospace</FontFamily>
        <FontFamily x:Key="FontFamilyDocument">Georgia, Source Serif 4, serif</FontFamily>
        <x:Double x:Key="FontSizeDisplay">44</x:Double>
        <x:Double x:Key="FontSizeH1">24</x:Double>
        <x:Double x:Key="FontSizeH2">20</x:Double>
        <x:Double x:Key="FontSizeH3">16</x:Double>
        <x:Double x:Key="FontSizeBody">14</x:Double>
        <x:Double x:Key="FontSizeBodySmall">12</x:Double>
        <x:Double x:Key="FontSizeCaption">11</x:Double>
        <x:Double x:Key="FontSizeMono">13</x:Double>
    </Styles.Resources>

    <!-- Global font on text controls -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyUi}" />
    </Style>

    <!-- Typography classes -->
    <Style Selector="TextBlock.Display">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="LineHeight" Value="48" />
        <Setter Property="LetterSpacing" Value="-0.5" />
    </Style>

    <Style Selector="TextBlock.H1">
        <Setter Property="FontSize" Value="{StaticResource FontSizeH1}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="LineHeight" Value="32" />
    </Style>

    <Style Selector="TextBlock.H2">
        <Setter Property="FontSize" Value="{StaticResource FontSizeH2}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="LineHeight" Value="28" />
    </Style>

    <Style Selector="TextBlock.H3">
        <Setter Property="FontSize" Value="{StaticResource FontSizeH3}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="LineHeight" Value="24" />
    </Style>

    <Style Selector="TextBlock.Body">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style Selector="TextBlock.BodyStrong">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style Selector="TextBlock.BodySmall">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBodySmall}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

    <Style Selector="TextBlock.Caption">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
        <Setter Property="LineHeight" Value="14" />
    </Style>

    <Style Selector="TextBlock.Mono">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMono}" />
        <Setter Property="FontFamily" Value="{StaticResource FontFamilyMono}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

</Styles>
