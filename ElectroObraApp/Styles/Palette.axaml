<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- Light: tablero de obra, oficina 7am -->
        <ResourceDictionary x:Key="Light">

            <!-- World surfaces -->
            <SolidColorBrush x:Key="Concrete" Color="#F3F1EC" />
            <SolidColorBrush x:Key="Paper" Color="#FFFCF7" />
            <SolidColorBrush x:Key="Revoque" Color="#E8E4DC" />

            <SolidColorBrush x:Key="SurfaceBase" Color="#F3F1EC" />
            <SolidColorBrush x:Key="SurfaceRaised" Color="#FFFCF7" />
            <SolidColorBrush x:Key="SurfaceSunken" Color="#E8E4DC" />
            <SolidColorBrush x:Key="SurfaceOverlay" Color="#80000000" />

            <SolidColorBrush x:Key="BorderSubtle" Color="#D8D2C8" />
            <SolidColorBrush x:Key="BorderStrong" Color="#C4BCB0" />

            <SolidColorBrush x:Key="LedgerInk" Color="#1A1916" />
            <SolidColorBrush x:Key="TextPrimary" Color="#1A1916" />
            <SolidColorBrush x:Key="TextSecondary" Color="#5C574F" />
            <SolidColorBrush x:Key="TextTertiary" Color="#8A8378" />
            <SolidColorBrush x:Key="TextDisabled" Color="#B5AEA3" />

            <!-- Copper accent (identity) -->
            <SolidColorBrush x:Key="Copper" Color="#B87333" />
            <SolidColorBrush x:Key="Accent" Color="#B87333" />
            <SolidColorBrush x:Key="AccentHover" Color="#A3662E" />
            <SolidColorBrush x:Key="AccentPressed" Color="#8F5828" />
            <SolidColorBrush x:Key="AccentSubtle" Color="#F5EBE0" />

            <!-- Blueprint (focus / links) -->
            <SolidColorBrush x:Key="Blueprint" Color="#2B5F8A" />
            <SolidColorBrush x:Key="Info" Color="#2B5F8A" />
            <SolidColorBrush x:Key="InfoSubtle" Color="#E8F0F6" />

            <SolidColorBrush x:Key="Success" Color="#2D6A3E" />
            <SolidColorBrush x:Key="SuccessSubtle" Color="#E6F2EA" />
            <SolidColorBrush x:Key="TapeAmber" Color="#C47A00" />
            <SolidColorBrush x:Key="Warning" Color="#C47A00" />
            <SolidColorBrush x:Key="WarningSubtle" Color="#FBF3E3" />
            <SolidColorBrush x:Key="Error" Color="#B3261E" />
            <SolidColorBrush x:Key="ErrorSubtle" Color="#FCEAE8" />

            <SolidColorBrush x:Key="AmountPositive" Color="#2D6A3E" />
            <SolidColorBrush x:Key="AmountNegative" Color="#B3261E" />

            <!-- Legacy aliases -->
            <SolidColorBrush x:Key="MainBackgroundBrush" Color="#F3F1EC" />
            <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#F3F1EC" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F3F1EC" />
            <SolidColorBrush x:Key="AccentBrush" Color="#B87333" />
            <SolidColorBrush x:Key="SidebarSeparatorBrush" Color="#E8E4DC" />
            <SolidColorBrush x:Key="MainForegroundBrush" Color="#1A1916" />
            <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#5C574F" />
            <SolidColorBrush x:Key="FilterPanelBackgroundBrush" Color="#E8E4DC" />
            <SolidColorBrush x:Key="FilterPanelBorderBrush" Color="#D8D2C8" />
            <SolidColorBrush x:Key="MutedForegroundBrush" Color="#5C574F" />
            <SolidColorBrush x:Key="DimForegroundBrush" Color="#8A8378" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#2D6A3E" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#B3261E" />
            <SolidColorBrush x:Key="WarningBrush" Color="#C47A00" />
            <SolidColorBrush x:Key="InfoBrush" Color="#2B5F8A" />
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#80000000" />

            <SolidColorBrush x:Key="NavActiveIndicator" Color="#B87333" />
            <SolidColorBrush x:Key="NavActiveBackground" Color="#F5EBE0" />

        </ResourceDictionary>

        <!-- Dark: turno noche en obra -->
        <ResourceDictionary x:Key="Dark">

            <SolidColorBrush x:Key="Concrete" Color="#1A1916" />
            <SolidColorBrush x:Key="Paper" Color="#242220" />
            <SolidColorBrush x:Key="Revoque" Color="#121110" />

            <SolidColorBrush x:Key="SurfaceBase" Color="#1A1916" />
            <SolidColorBrush x:Key="SurfaceRaised" Color="#242220" />
            <SolidColorBrush x:Key="SurfaceSunken" Color="#121110" />
            <SolidColorBrush x:Key="SurfaceOverlay" Color="#B3000000" />

            <SolidColorBrush x:Key="BorderSubtle" Color="#3A3630" />
            <SolidColorBrush x:Key="BorderStrong" Color="#4A4540" />

            <SolidColorBrush x:Key="LedgerInk" Color="#F3F1EC" />
            <SolidColorBrush x:Key="TextPrimary" Color="#F3F1EC" />
            <SolidColorBrush x:Key="TextSecondary" Color="#9A948A" />
            <SolidColorBrush x:Key="TextTertiary" Color="#6B655C" />
            <SolidColorBrush x:Key="TextDisabled" Color="#4A4540" />

            <SolidColorBrush x:Key="Copper" Color="#C98844" />
            <SolidColorBrush x:Key="Accent" Color="#C98844" />
            <SolidColorBrush x:Key="AccentHover" Color="#D49552" />
            <SolidColorBrush x:Key="AccentPressed" Color="#B87A3A" />
            <SolidColorBrush x:Key="AccentSubtle" Color="#2A2218" />

            <SolidColorBrush x:Key="Blueprint" Color="#5A8FB8" />
            <SolidColorBrush x:Key="Info" Color="#5A8FB8" />
            <SolidColorBrush x:Key="InfoSubtle" Color="#1A2430" />

            <SolidColorBrush x:Key="Success" Color="#4CAF6A" />
            <SolidColorBrush x:Key="SuccessSubtle" Color="#1A2E22" />
            <SolidColorBrush x:Key="TapeAmber" Color="#E09A2E" />
            <SolidColorBrush x:Key="Warning" Color="#E09A2E" />
            <SolidColorBrush x:Key="WarningSubtle" Color="#2E2618" />
            <SolidColorBrush x:Key="Error" Color="#EF5350" />
            <SolidColorBrush x:Key="ErrorSubtle" Color="#2E1A1A" />

            <SolidColorBrush x:Key="AmountPositive" Color="#4CAF6A" />
            <SolidColorBrush x:Key="AmountNegative" Color="#EF5350" />

            <SolidColorBrush x:Key="MainBackgroundBrush" Color="#1A1916" />
            <SolidColorBrush x:Key="PaneBackgroundBrush" Color="#1A1916" />
            <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1A1916" />
            <SolidColorBrush x:Key="AccentBrush" Color="#C98844" />
            <SolidColorBrush x:Key="SidebarSeparatorBrush" Color="#3A3630" />
            <SolidColorBrush x:Key="MainForegroundBrush" Color="#F3F1EC" />
            <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#9A948A" />
            <SolidColorBrush x:Key="FilterPanelBackgroundBrush" Color="#121110" />
            <SolidColorBrush x:Key="FilterPanelBorderBrush" Color="#3A3630" />
            <SolidColorBrush x:Key="MutedForegroundBrush" Color="#9A948A" />
            <SolidColorBrush x:Key="DimForegroundBrush" Color="#6B655C" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF6A" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#EF5350" />
            <SolidColorBrush x:Key="WarningBrush" Color="#E09A2E" />
            <SolidColorBrush x:Key="InfoBrush" Color="#5A8FB8" />
            <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#B3000000" />

            <SolidColorBrush x:Key="NavActiveIndicator" Color="#C98844" />
            <SolidColorBrush x:Key="NavActiveBackground" Color="#2A2218" />

        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
