<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ElectroObraApp.Controls"
             x:Class="ElectroObraApp.Controls.PageHeader"
             x:DataType="controls:PageHeader">
    <Grid ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,8">
        <StackPanel Spacing="{StaticResource Space4}">
            <TextBlock Text="{Binding Title}"
                       Classes="H1"
                       IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding Subtitle}"
                       Classes="BodySmall"
                       IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <ContentControl Grid.Column="1"
                        Content="{Binding Actions, RelativeSource={RelativeSource AncestorType=controls:PageHeader}}"
                        VerticalAlignment="Center" />
    </Grid>
</UserControl>
