<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:ElectroObraApp.Controls"
             xmlns:vm="clr-namespace:ElectroObraApp.ViewModels"
             xmlns:dto="clr-namespace:ElectroObraApp.Application.DTOs;assembly=ElectroObraApp.Application"
             xmlns:loc="using:ElectroObraApp.Markup"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="560"
             d:DesignHeight="220"
             x:Class="ElectroObraApp.Controls.AttachmentPanel"
             x:DataType="vm:AttachmentPanelViewModel">
    <StackPanel Spacing="10">
        <TextBlock Text="{loc:Translate Key=Attachments.Title}"
                   Classes="filterLabel"
                   Foreground="{DynamicResource TextTertiary}" />

        <Border x:Name="DropZone"
                Background="{DynamicResource FilterPanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius8}"
                Padding="16"
                MinHeight="72"
                IsEnabled="{Binding CanManage}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <materialIcons:MaterialIcon Kind="Paperclip"
                                            Width="24"
                                            Height="24"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextTertiary}" />
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBlock Text="{loc:Translate Key=Attachments.DropZone}"
                               Classes="BodySmall"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondary}" />
                    <Button Content="{loc:Translate Key=Attachments.AddFiles}"
                            Classes="eo-secondary"
                            HorizontalAlignment="Left"
                            Click="BrowseFiles_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{DynamicResource ErrorBrush}"
                   TextWrapping="Wrap"
                   IsVisible="{Binding HasError}" />

        <Border Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius8}"
                Padding="8"
                MinHeight="56">
            <Panel>
                <TextBlock Text="{loc:Translate Key=Attachments.Empty}"
                           Classes="BodySmall"
                           Foreground="{DynamicResource TextTertiary}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsEmpty}" />

                <ItemsControl ItemsSource="{Binding Adjuntos}"
                              IsVisible="{Binding !IsEmpty}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dto:AdjuntoDto">
                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  Margin="0,4"
                                  ColumnSpacing="8">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding NombreArchivo}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1"
                                        Content="{loc:Translate Key=Attachments.Open}"
                                        Classes="eo-secondary"
                                        Padding="12,4"
                                        Command="{Binding $parent[controls:AttachmentPanel].((vm:AttachmentPanelViewModel)DataContext).OpenCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Grid.Column="2"
                                        Content="{loc:Translate Key=Attachments.Delete}"
                                        Classes="eo-secondary"
                                        Padding="12,4"
                                        Command="{Binding $parent[controls:AttachmentPanel].((vm:AttachmentPanelViewModel)DataContext).DeleteCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Panel>
        </Border>
    </StackPanel>
</UserControl>
