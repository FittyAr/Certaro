<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ElectroObraApp.Markup"
             xmlns:controls="using:ElectroObraApp.Controls"
             x:Class="ElectroObraApp.Controls.ListStateOverlay"
             x:DataType="controls:ListStateOverlay">
    <Grid>
        <Border Background="#80000000" IsVisible="{Binding IsLoading}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <ProgressBar IsIndeterminate="True" Width="200" />
                <TextBlock Text="{loc:Translate Key=General.Loading}" HorizontalAlignment="Center" Foreground="{DynamicResource MainForegroundBrush}" />
            </StackPanel>
        </Border>

        <Border Background="#80000000" IsVisible="{Binding IsEmpty}">
            <TextBlock Text="{loc:Translate Key=General.NoData}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedForegroundBrush}" FontSize="16" />
        </Border>

        <Border Background="#80000000" IsVisible="{Binding HasError}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#ff5252" TextWrapping="Wrap" MaxWidth="400" HorizontalAlignment="Center" />
                <Button Content="{loc:Translate Key=General.Retry}"
                        Command="{Binding RetryCommand}"
                        Classes="accent" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
