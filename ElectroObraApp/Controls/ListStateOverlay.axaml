<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ElectroObraApp.Markup"
             xmlns:controls="using:ElectroObraApp.Controls"
             x:Class="ElectroObraApp.Controls.ListStateOverlay"
             x:DataType="controls:ListStateOverlay">
    <Grid>
        <Border Background="{DynamicResource SurfaceOverlay}" IsVisible="{Binding IsLoading}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource Space12}">
                <ProgressBar IsIndeterminate="True" Width="200" />
                <TextBlock Text="{loc:Translate Key=General.Loading}"
                           HorizontalAlignment="Center"
                           Classes="Body"
                           Foreground="{DynamicResource TextPrimary}" />
            </StackPanel>
        </Border>

        <Border Background="{DynamicResource SurfaceOverlay}" IsVisible="{Binding IsEmpty}">
            <TextBlock Text="{loc:Translate Key=General.NoData}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Classes="H3"
                       Foreground="{DynamicResource TextSecondary}" />
        </Border>

        <Border Background="{DynamicResource SurfaceOverlay}" IsVisible="{Binding HasError}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource Space12}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource Error}"
                           TextWrapping="Wrap"
                           MaxWidth="400"
                           HorizontalAlignment="Center"
                           Classes="Body" />
                <Button Content="{loc:Translate Key=General.Retry}"
                        Command="{Binding RetryCommand}"
                        Classes="eo-primary"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
