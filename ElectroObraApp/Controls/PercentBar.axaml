<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:ElectroObraApp.Controls"
             x:Class="ElectroObraApp.Controls.PercentBar"
             x:DataType="controls:PercentBar">
    <StackPanel Spacing="{StaticResource Space4}">
        <ProgressBar x:Name="Bar"
                     Minimum="0"
                     Maximum="100"
                     Height="6" />
        <TextBlock x:Name="PercentText"
                   Classes="Caption"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource Success}" />
    </StackPanel>
</UserControl>
