<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ElectroObraApp.ViewModels"
             xmlns:loc="using:ElectroObraApp.Markup"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="640"
             d:DesignHeight="480"
             x:Class="ElectroObraApp.Controls.CommandPaletteOverlay"
             x:DataType="vm:CommandPaletteViewModel"
             Focusable="True">

    <UserControl.KeyBindings>
        <KeyBinding Gesture="Enter" Command="{Binding ExecuteSelectedCommand}"/>
    </UserControl.KeyBindings>

    <Border Background="{DynamicResource SurfaceOverlay}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Border MaxWidth="560"
                Margin="24,80,24,24"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="12"
                BoxShadow="0 8 32 0 #66000000">
            <Grid RowDefinitions="Auto, Auto, *">
                <Border Grid.Row="0"
                        Padding="16,14"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto, *">
                        <material:MaterialIcon Kind="Magnify"
                                               Width="20"
                                               Height="20"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiary}" />
                        <TextBox Grid.Column="1"
                                 Margin="12,0,0,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 PlaceholderText="{loc:Translate Key=CommandPalette.SearchPlaceholder}"
                                 Text="{Binding SearchQuery, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1"
                           Margin="16,8,16,4"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextTertiary}"
                           Text="{loc:Translate Key=CommandPalette.Hint}" />

                <ListBox Grid.Row="2"
                         MaxHeight="320"
                         Margin="8,0,8,8"
                         ItemsSource="{Binding FilteredCommands}"
                         SelectedItem="{Binding SelectedItem}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CommandPaletteItem">
                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Padding="8,10"
                                    Command="{Binding $parent[ListBox].((vm:CommandPaletteViewModel)DataContext).ExecuteItemCommand}"
                                    CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="*, Auto">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource MainForegroundBrush}" />
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextTertiary}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextTertiary}"
                                               Text="{Binding Route}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Border>
</UserControl>
