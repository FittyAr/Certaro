<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ElectroObraApp.ViewModels"
             xmlns:controls="clr-namespace:ElectroObraApp.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:loc="using:ElectroObraApp.Markup"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="ElectroObraApp.Views.EmpleadosView"
             x:DataType="vm:EmpleadosViewModel">
    <controls:MasterDetailLayout>
        <controls:MasterDetailLayout.Master>
        <DockPanel>
            <controls:PageHeader DockPanel.Dock="Top" Title="{loc:Translate Key=Employees.Title}">
                <controls:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{loc:Translate Key=General.Add}" Classes="eo-primary" Command="{Binding AddCommand}" />
                        <Button Content="{loc:Translate Key=General.Refresh}" Classes="eo-secondary" Command="{Binding LoadEmpleadosCommand}" />
                    </StackPanel>
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <controls:FilterBar DockPanel.Dock="Top"
                                Header="{loc:Translate Key=Employees.SearchFilters}">
                <controls:FilterBar.FilterContent>
                    <StackPanel Spacing="10">
                        <Button HorizontalAlignment="Right"
                                Content="{loc:Translate Key=General.ClearFilters}"
                                Classes="link"
                                Command="{Binding LimpiarFiltrosCommand}" />
                        <WrapPanel Orientation="Horizontal" Margin="-5">
                            <StackPanel Margin="5">
                                <TextBlock Text="{loc:Translate Key=Employees.NameRole}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}" />
                                <TextBox Width="200" Text="{Binding FiltroNombre}" PlaceholderText="{loc:Translate Key=General.Search}" />
                            </StackPanel>
                            <StackPanel Margin="5">
                                <TextBlock Text="{loc:Translate Key=Jobs.Status}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}" />
                                <ComboBox Width="120" SelectedIndex="{Binding FiltroEstadoIndex}">
                                    <ComboBoxItem Content="{loc:Translate Key=General.All}" />
                                    <ComboBoxItem Content="{loc:Translate Key=Employees.Active}" />
                                    <ComboBoxItem Content="{loc:Translate Key=Employees.Inactive}" />
                                </ComboBox>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </controls:FilterBar.FilterContent>
            </controls:FilterBar>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <TextBlock Text="{loc:Translate Key=General.ItemsPerPage}" Classes="pageSizeLabel" Foreground="{DynamicResource TextTertiary}" />
                <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PageSizeConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <Grid>
                <DataGrid ItemsSource="{Binding Empleados}"
                          Classes="eo-grid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          x:CompileBindings="False"
                          DoubleTapped="OnDataGridDoubleTapped"
                          IsVisible="{Binding !IsLoading}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Translate Key=Clients.Name}" Binding="{Binding Nombre, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="{loc:Translate Key=Employees.Dni}" Binding="{Binding Dni, Mode=OneWay}" />
                        <DataGridTextColumn Header="{loc:Translate Key=Employees.Role}" Binding="{Binding Cargo, Mode=OneWay}" />
                        <DataGridTextColumn Header="{loc:Translate Key=Employees.BaseSalary}" Binding="{Binding SueldoBase, StringFormat=\{0:C\}, Mode=OneWay}" />
                        <DataGridTextColumn Header="{loc:Translate Key=Employees.HireDate}" Binding="{Binding FechaIngreso, StringFormat=\{0:dd/MM/yyyy\}, Mode=OneWay}" />
                        <DataGridCheckBoxColumn Header="{loc:Translate Key=Employees.Active}" Binding="{Binding Activo, Mode=OneWay}" />
                        <DataGridTemplateColumn Header="{loc:Translate Key=Employees.Communication}" Width="Auto">
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Button Command="{Binding $parent[UserControl].((vm:EmpleadosViewModel)DataContext).SendEmailCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding Email, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            ToolTip.Tip="{loc:Translate Key=Employees.SendEmail}"
                                            Padding="5" Background="Transparent" BorderThickness="0">
                                        <materialIcons:MaterialIcon Kind="Email" Width="18" Height="18" Foreground="{DynamicResource Success}" />
                                    </Button>
                                    <Button Command="{Binding $parent[UserControl].((vm:EmpleadosViewModel)DataContext).SendWhatsAppCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding Telefono, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            ToolTip.Tip="{loc:Translate Key=Employees.SendWhatsApp}"
                                            Padding="5" Background="Transparent" BorderThickness="0">
                                        <materialIcons:MaterialIcon Kind="Whatsapp" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <controls:ListStateOverlay IsLoading="{Binding IsLoading}"
                                           IsEmpty="{Binding IsEmpty}"
                                           HasError="{Binding HasError}"
                                           ErrorMessage="{Binding ErrorMessage}"
                                           RetryCommand="{Binding LoadEmpleadosCommand}" />
            </Grid>
        </DockPanel>
        </controls:MasterDetailLayout.Master>

        <controls:MasterDetailLayout.Detail>
        <Border Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius12}"
                MinWidth="320">
            <Grid>
                <ContentControl Content="{Binding EditViewModel}" IsVisible="{Binding IsEditing}" />
                <controls:EmptyState IsVisible="{Binding !IsEditing}"
                                     IconKind="BadgeAccount"
                                     Title="{loc:Translate Key=Employees.Title}"
                                     Description="{loc:Translate Key=General.SelectRecordHint}"
                                     ActionText="{loc:Translate Key=General.Add}"
                                     ActionCommand="{Binding AddCommand}" />
            </Grid>
        </Border>
        </controls:MasterDetailLayout.Detail>
    </controls:MasterDetailLayout>
</UserControl>
