<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ElectroObraApp.ViewModels"
             xmlns:dto="clr-namespace:ElectroObraApp.Application.DTOs;assembly=ElectroObraApp.Application"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Avalonia;assembly=LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:conv="using:ElectroObraApp.Views.Converters"
             xmlns:controls="clr-namespace:ElectroObraApp.Controls"
             xmlns:loc="using:ElectroObraApp.Markup"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="1200"
             x:Class="ElectroObraApp.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    
    <UserControl.Resources>
        <conv:BoolToObjectConverter x:Key="BoolToIconConverter" TrueValue="EyeOff" FalseValue="Eye" />
        <conv:BoolToObjectConverter x:Key="BoolToColorConverter" TrueValue="{DynamicResource Error}" FalseValue="{DynamicResource Success}" />
        <conv:BoolToObjectConverter x:Key="AlertBackgroundConverter" TrueValue="{DynamicResource WarningSubtle}" FalseValue="{DynamicResource SuccessSubtle}" />
        <conv:BoolToObjectConverter x:Key="AlertBorderConverter" TrueValue="{DynamicResource Warning}" FalseValue="{DynamicResource Success}" />
    </UserControl.Resources>

    <Grid>
    <ScrollViewer IsVisible="{Binding !IsLoading}">
        <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto" Margin="0">
            <!-- Header & Controls -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="0,0,0,16">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Translate Key=Dashboard.Title}" Classes="H1" />
                    <TextBlock Text="{loc:Translate Key=Dashboard.Subtitle}" Classes="BodySmall" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="{loc:Translate Key=Dashboard.Period}" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                    <ComboBox ItemsSource="{Binding TimeRanges}" 
                              SelectedItem="{Binding CurrentTimeRange}" 
                              Width="120" />
                </StackPanel>

                <ToggleButton Grid.Column="2" 
                              IsChecked="{Binding IsPrivacyModeActive}"
                              Classes="privacyButton"
                              ToolTip.Tip="{loc:Translate Key=Dashboard.PrivacyModeTooltip}">
                    <materialIcons:MaterialIcon Kind="{Binding IsPrivacyModeActive, Converter={StaticResource BoolToIconConverter}}" 
                                                Width="24" Height="24"
                                                Foreground="{Binding IsPrivacyModeActive, Converter={StaticResource BoolToColorConverter}}" />
                </ToggleButton>
            </Grid>

            <!-- Dollar Rates Banner -->
            <Border Grid.Row="1" IsVisible="{Binding ShowDollarRates}" 
                    Background="{DynamicResource SidebarBackgroundBrush}" 
                    CornerRadius="15" Margin="0,0,0,20" Padding="15,10">
                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,8">
                        <materialIcons:MaterialIcon Kind="CurrencyUsd" Foreground="{DynamicResource Warning}" Width="20" Height="20"/>
                        <TextBlock Text="{loc:Translate Key=Dashboard.DollarRate}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource MainForegroundBrush}"/>
                    </StackPanel>
                    
                    <ItemsControl ItemsSource="{Binding DollarRates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:DollarDto">
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,25,8">
                                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{loc:Translate Key=Dashboard.Buy}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock Text="{Binding Compra, StringFormat=\{0:C\}}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource AmountPositive}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{loc:Translate Key=Dashboard.Sell}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        <TextBlock Text="{Binding Venta, StringFormat=\{0:C\}}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource AmountNegative}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>
            </Border>

            <!-- Hero balance -->
            <Border Grid.Row="2" Classes="eo-card" Margin="0,0,0,16">
                <Grid ColumnDefinitions="*, Auto, Auto, Auto" ColumnSpacing="24">
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Translate Key=Dashboard.Balance}" Classes="Caption" />
                        <TextBlock Text="{Binding DisplayBalance}" Classes="Display" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{loc:Translate Key=Dashboard.Profitability}" Classes="BodySmall" />
                            <TextBlock Text="{Binding DisplayRentabilidad}" Classes="Mono" Foreground="{DynamicResource Copper}" />
                            <TextBlock Text="{Binding IngresosTrend}" Classes="Caption" IsVisible="{Binding !IsPrivacyModeActive}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MinWidth="120">
                        <TextBlock Text="{loc:Translate Key=Dashboard.Income}" Classes="Caption" />
                        <TextBlock Text="{Binding DisplayTotalIngresos}" Classes="Mono" Foreground="{DynamicResource AmountPositive}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center" MinWidth="120">
                        <TextBlock Text="{loc:Translate Key=Dashboard.Expenses}" Classes="Caption" />
                        <TextBlock Text="{Binding DisplayTotalGastos}" Classes="Mono" Foreground="{DynamicResource AmountNegative}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="2" VerticalAlignment="Center" MinWidth="120">
                        <TextBlock Text="{loc:Translate Key=Dashboard.OverdueInvoices}" Classes="Caption" />
                        <TextBlock Text="{Binding FacturasVencidasCount}" Classes="H2" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Secondary metrics -->
            <Grid Grid.Row="3" ColumnDefinitions="*, *, *" ColumnSpacing="12" Margin="0,0,0,16">
                <Border Classes="eo-surface" Padding="16">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:Translate Key=Dashboard.ActiveClients}" Classes="Caption" />
                        <TextBlock Text="{Binding DisplayClientesActivos}" Classes="H2" />
                    </StackPanel>
                </Border>
                <Border Classes="eo-surface" Padding="16">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:Translate Key=Dashboard.Pending}" Classes="Caption" />
                        <TextBlock Text="{Binding TrabajosPendientes}" Classes="H2" />
                    </StackPanel>
                </Border>
                <Border Classes="eo-surface" Padding="16">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:Translate Key=Dashboard.WorksRanking}" Classes="Caption" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ObrasPausadasText}" Classes="BodyStrong" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Main Charts Row -->
            <Grid Grid.Row="4" ColumnDefinitions="2*, *" Margin="0,0,0,20">
                <Border Classes="chartCard" Grid.Column="0" Margin="0,0,10,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Translate Key=Dashboard.FinancialEvolution}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource MainForegroundBrush}"/>
                        <lvc:CartesianChart Series="{Binding Series}" 
                                            XAxes="{Binding XAxes}" 
                                            Height="350"
                                            Background="Transparent"
                                            TooltipPosition="{Binding ChartTooltipPosition}"/>
                    </StackPanel>
                </Border>

                <Border Classes="chartCard" Grid.Column="1" Margin="10,0,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{loc:Translate Key=Dashboard.Distribution}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource MainForegroundBrush}"/>
                        <lvc:PieChart Series="{Binding CategorySeries}" 
                                      Height="350" 
                                      Background="Transparent"
                                      TooltipPosition="{Binding PieTooltipPosition}"
                                      LegendPosition="Bottom"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Intelligence Row -->
            <Grid Grid.Row="5" ColumnDefinitions="*, *, *" Margin="0,0,0,20">
                <Border Classes="chartCard" Grid.Column="0" Margin="0,0,10,0">
                    <StackPanel Spacing="15">
                        <TextBlock Text="{loc:Translate Key=Dashboard.TopClients}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MainForegroundBrush}"/>
                        <ItemsControl ItemsSource="{Binding TopClientes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TopClienteDto">
                                    <Border Background="{DynamicResource SurfaceSunken}" Margin="0,0,0,8" Padding="12" CornerRadius="{StaticResource Radius8}">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBlock Text="{Binding Nombre}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Total, StringFormat=\{0:C\}}" Foreground="{DynamicResource AmountPositive}" FontWeight="Bold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="chartCard" Grid.Column="1" Margin="10,0,10,0">
                    <StackPanel Spacing="15">
                        <TextBlock Text="{loc:Translate Key=Dashboard.WorksRanking}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MainForegroundBrush}"/>
                        <ItemsControl ItemsSource="{Binding RankingObras}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ObraRankingDto">
                                    <Border Background="{DynamicResource SurfaceSunken}" Margin="0,0,0,8" Padding="12" CornerRadius="{StaticResource Radius8}">
                                        <Grid ColumnDefinitions="*, Auto, Auto">
                                            <TextBlock Text="{Binding Nombre}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayRentabilidad}" Foreground="{DynamicResource Info}" FontWeight="Bold" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding MargenPorcentaje, StringFormat=\{0:N1\}%}" Foreground="{DynamicResource SecondaryForegroundBrush}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Classes="chartCard" Grid.Column="2" Margin="10,0,0,0">
                    <StackPanel Spacing="15">
                        <TextBlock Text="{loc:Translate Key=Dashboard.RecentActivity}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MainForegroundBrush}"/>
                        <ItemsControl ItemsSource="{Binding RecentMovimientos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dto:MovimientoDto">
                                    <Border BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,0,0,1" Padding="0,5,0,5">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            <TextBlock Text="{Binding Fecha, StringFormat=\{0:dd/MM\}}" Foreground="{DynamicResource SecondaryForegroundBrush}" Width="40"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Concepto}" Foreground="{DynamicResource MainForegroundBrush}" TextTrimming="CharacterEllipsis" Margin="5,0"/>
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding Total, StringFormat=\{0:C\}}" 
                                                       Foreground="{Binding TipoMovimientoSuma, Converter={StaticResource BoolToColorConverter}}"
                                                       FontWeight="Bold"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Alerts Row -->
            <Border Grid.Row="6" Classes="chartCard">
                <StackPanel Spacing="15">
                    <TextBlock Text="{loc:Translate Key=Dashboard.Alerts}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource MainForegroundBrush}"/>
                    <StackPanel Spacing="8">
                        <Button Classes="alertButton" HorizontalAlignment="Stretch"
                                Command="{Binding NavigateToAlertCommand}" CommandParameter="liquidaciones">
                            <Border Background="{Binding ShowLiquidacionesAlert, Converter={StaticResource AlertBackgroundConverter}}"
                                    Padding="12,10" CornerRadius="{StaticResource Radius8}"
                                    BorderBrush="{Binding ShowLiquidacionesAlert, Converter={StaticResource AlertBorderConverter}}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding LiquidacionesPendientesText}" FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </Border>
                        </Button>
                        <Button Classes="alertButton" HorizontalAlignment="Stretch"
                                Command="{Binding NavigateToAlertCommand}" CommandParameter="facturas">
                            <Border Background="{Binding ShowFacturasVencidasAlert, Converter={StaticResource AlertBackgroundConverter}}"
                                    Padding="12,10" CornerRadius="{StaticResource Radius8}"
                                    BorderBrush="{Binding ShowFacturasVencidasAlert, Converter={StaticResource AlertBorderConverter}}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding FacturasVencidasText}" FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </Border>
                        </Button>
                        <Button Classes="alertButton" HorizontalAlignment="Stretch"
                                Command="{Binding NavigateToAlertCommand}" CommandParameter="obras">
                            <Border Background="{Binding ShowObrasPausadasAlert, Converter={StaticResource AlertBackgroundConverter}}"
                                    Padding="12,10" CornerRadius="{StaticResource Radius8}"
                                    BorderBrush="{Binding ShowObrasPausadasAlert, Converter={StaticResource AlertBorderConverter}}"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding ObrasPausadasText}" FontSize="13"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </Border>
                        </Button>
                    </StackPanel>
                    <Border Background="{DynamicResource InfoSubtle}" Padding="12" CornerRadius="{StaticResource Radius8}" BorderBrush="{DynamicResource Info}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <materialIcons:MaterialIcon Kind="InformationOutline" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource Info}" />
                            <TextBlock Text="{Binding DatabaseStatus}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource MainForegroundBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>

    <controls:ListStateOverlay IsLoading="{Binding IsLoading}"
                               IsEmpty="{Binding IsEmpty}"
                               HasError="{Binding HasError}"
                               ErrorMessage="{Binding ErrorMessage}"
                               RetryCommand="{Binding LoadStatsCommand}" />
    </Grid>

    <UserControl.Styles>
        <Style Selector="Border.chartCard">
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
            <Setter Property="CornerRadius" Value="{StaticResource Radius12}" />
            <Setter Property="Padding" Value="{StaticResource Padding24}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="{StaticResource Elevation1}" />
        </Style>

        <Style Selector="ToggleButton.privacyButton">
            <Setter Property="Background" Value="{DynamicResource PaneBackgroundBrush}" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Width" Value="45" />
            <Setter Property="Height" Value="45" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SidebarSeparatorBrush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" 
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        
        <Style Selector="ToggleButton.privacyButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource SidebarSeparatorBrush}" />
        </Style>
        
        <Style Selector="ToggleButton.privacyButton:checked">
            <Setter Property="Background" Value="{DynamicResource ErrorSubtle}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Error}" />
        </Style>

        <Style Selector="Button.alertButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Styles>
</UserControl>
