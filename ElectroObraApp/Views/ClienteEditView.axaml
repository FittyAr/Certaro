<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ElectroObraApp.ViewModels"
             xmlns:loc="using:ElectroObraApp.Markup"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             x:Class="ElectroObraApp.Views.ClienteEditView"
             x:DataType="vm:ClienteEditViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}"/>
    </UserControl.KeyBindings>
    <Border Padding="25"
            Background="{DynamicResource SurfaceRaised}"
            CornerRadius="{StaticResource Radius12}"
            BoxShadow="{StaticResource Elevation2}"
            Width="600"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1">
        <ScrollViewer MaxHeight="750">
            <StackPanel Spacing="18" Margin="0,0,15,0">
                <TextBlock Text="{Binding Title}" Classes="H1" Margin="0,0,0,5"/>

            <StackPanel Spacing="5">
                <TextBlock Text="{loc:Translate Key=Clients.Name}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}"/>
                <TextBox Text="{Binding Cliente.Nombre}" PlaceholderText="Ej: Electro S.A." Classes="eo-input"/>
            </StackPanel>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="20" RowDefinitions="Auto, Auto" RowSpacing="15">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
                    <TextBlock Text="{loc:Translate Key=Clients.Cuit}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}"/>
                    <TextBox Text="{Binding Cliente.Cuit}" PlaceholderText="20-XXXXXXXX-X" Classes="eo-input"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
                    <TextBlock Text="{loc:Translate Key=Clients.TaxCondition}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}"/>
                    <TextBox Text="{Binding Cliente.CondicionIva}" PlaceholderText="Responsable Inscripto" Classes="eo-input"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                    <TextBlock Text="{loc:Translate Key=Clients.Phone}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}"/>
                    <TextBox Text="{Binding Cliente.Telefono}" Classes="eo-input"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                    <TextBlock Text="{loc:Translate Key=Clients.Email}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Text="{Binding Cliente.Email}" Classes="eo-input"/>
                        <Button Grid.Column="1" Command="{Binding OpenEmailCommand}"
                                Padding="8,4" Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center" ToolTip.Tip="{loc:Translate Key=Clients.SendEmail}">
                            <PathIcon Data="M20,4H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V6C22,4.9,21.1,4,20,4z M20,18H4V8l8,5l8,-5V18z M12,11L4,6h16L12,11z"
                                      Width="16" Height="16" Foreground="{DynamicResource Accent}"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <Separator Background="{DynamicResource BorderStrong}" Margin="0,5"/>

            <StackPanel Spacing="10">
                <DockPanel>
                    <TextBlock Text="{loc:Translate Key=Clients.OtherContacts}" Classes="H3" VerticalAlignment="Center"/>
                    <Button Content="+" Command="{Binding AddContactCommand}" HorizontalAlignment="Right" Width="28" Height="28" Padding="0" CornerRadius="14"/>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding Cliente.Contactos}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="120,*,Auto" Margin="0,2" ColumnSpacing="10">
                                <TextBox Grid.Column="0" Text="{Binding Etiqueta}" PlaceholderText="{loc:Translate Key=Clients.ContactLabel}" Classes="eo-input"/>
                                <TextBox Grid.Column="1" Text="{Binding Email}" PlaceholderText="Email" Classes="eo-input"/>
                                <Button Grid.Column="2" Content="✕" Command="{Binding $parent[UserControl].((vm:ClienteEditViewModel)DataContext).RemoveContactCommand}" CommandParameter="{Binding}" Foreground="{DynamicResource Error}" Classes="link"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Separator Background="{DynamicResource BorderStrong}" Margin="0,5"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,10,0,0">
                <Button Content="{loc:Translate Key=General.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" Padding="20,0" Classes="eo-secondary"/>
                <Button Content="{loc:Translate Key=General.Save}" Classes="eo-primary" Command="{Binding SaveCommand}" IsDefault="True" Padding="20,0"/>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
