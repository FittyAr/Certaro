<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ElectroObraApp.ViewModels"
             xmlns:loc="using:ElectroObraApp.Markup"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             x:Class="ElectroObraApp.Views.EmpleadoEditView"
             x:DataType="vm:EmpleadoEditViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}"/>
    </UserControl.KeyBindings>
    <Border Padding="25"
            Background="{DynamicResource SurfaceRaised}"
            CornerRadius="{StaticResource Radius12}"
            BoxShadow="{StaticResource Elevation2}"
            Width="600"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1">
        <ScrollViewer MaxHeight="700">
            <StackPanel Spacing="18" Margin="0,0,15,0">
                <TextBlock Text="{Binding Title}" Classes="H1" Margin="0,0,0,5"/>

            <StackPanel Spacing="5">
                <TextBlock Text="{loc:Translate Key=Employees.FullName}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}"/>
                <TextBox Text="{Binding Empleado.Nombre}" PlaceholderText="Ej: Juan Pérez" Classes="eo-input"/>
            </StackPanel>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="20" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="15">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="5">
                    <TextBlock Text="{loc:Translate Key=Employees.Dni}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}"/>
                    <TextBox Text="{Binding Empleado.Dni}" PlaceholderText="8 dígitos" Classes="eo-input"/>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="5">
                    <TextBlock Text="{loc:Translate Key=Employees.Role}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}"/>
                    <TextBox Text="{Binding Empleado.Cargo}" PlaceholderText="Ej: Electricista" Classes="eo-input"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="5">
                    <TextBlock Text="{loc:Translate Key=Employees.BaseSalary}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}"/>
                    <NumericUpDown Value="{Binding Empleado.SueldoBase}" FormatString="C2" Classes="eo-input" HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5">
                    <TextBlock Text="{loc:Translate Key=Employees.PaymentFrequency}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}"/>
                    <ComboBox ItemsSource="{Binding PaymentFrequencies}"
                              SelectedItem="{Binding Empleado.PagoFrecuencia}"
                              Classes="eo-input"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Spacing="5">
                    <TextBlock Text="{loc:Translate Key=Employees.DailyRateCalculated}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}"/>
                    <NumericUpDown Value="{Binding Empleado.TarifaDiaria}" FormatString="C2" Classes="eo-input" HorizontalAlignment="Stretch"
                                   ToolTip.Tip="Valor diario para liquidaciones. Si es mensual: Sueldo/30."/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Spacing="5">
                    <TextBlock Text="{loc:Translate Key=Employees.HireDate}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}"/>
                    <CalendarDatePicker SelectedDate="{Binding FechaIngresoOffset}" Classes="eo-input" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="0" Spacing="5">
                    <TextBlock Text="{loc:Translate Key=Employees.Email}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}"/>
                    <TextBox Text="{Binding Empleado.Email}" PlaceholderText="ejemplo@correo.com" Classes="eo-input"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="5">
                    <TextBlock Text="{loc:Translate Key=Employees.Phone}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}"/>
                    <TextBox Text="{Binding Empleado.Telefono}" PlaceholderText="Cód. Área + Número" Classes="eo-input"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,10,0,0">
                <Button Content="{loc:Translate Key=General.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" Padding="20,0" Classes="eo-secondary"/>
                <Button Content="{loc:Translate Key=General.Save}" Classes="eo-primary" Command="{Binding SaveCommand}" IsDefault="True" Padding="20,0"/>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
