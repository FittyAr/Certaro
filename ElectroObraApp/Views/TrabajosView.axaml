<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ElectroObraApp.ViewModels"
             xmlns:controls="clr-namespace:ElectroObraApp.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:loc="using:ElectroObraApp.Markup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ElectroObraApp.Views.TrabajosView"
             x:DataType="vm:TrabajosViewModel">
    <Grid>
        <DockPanel Margin="20" IsVisible="{Binding !IsEditing}">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                    <TextBlock Text="Trabajos / Proyectos" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Content="Agregar" Classes="accent" Command="{Binding AddCommand}" />
                    <Button Content="Refrescar" Command="{Binding LoadTrabajosCommand}" />
                </StackPanel>
            </Grid>

            <Border DockPanel.Dock="Top" Classes="filterPanel" Margin="0,0,0,20">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Filter" Width="16" Height="16" Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock Text="{loc:Translate Key=Jobs.SearchFilters}" Classes="filterTitle"/>
                        </StackPanel>
                        <Button Grid.Column="1" HorizontalAlignment="Right" Content="{loc:Translate Key=General.ClearFilters}" Classes="link" Command="{Binding LimpiarFiltrosCommand}" FontSize="11"/>
                    </Grid>

                    <WrapPanel Orientation="Horizontal" Margin="-5">
                        <StackPanel Margin="5">
                            <TextBlock Text="Descripción / Nombre" FontSize="10" Foreground="#aaa" Margin="0,0,0,4"/>
                            <TextBox Width="200" Text="{Binding FiltroNombre}" PlaceholderText="Buscar..."/>
                        </StackPanel>
                        
                        <StackPanel Margin="5">
                            <TextBlock Text="Cliente" FontSize="10" Foreground="#aaa" Margin="0,0,0,4"/>
                            <ComboBox Width="150" 
                                      ItemsSource="{Binding Clientes}" 
                                      SelectedValue="{Binding FiltroClienteId}" 
                                      SelectedValueBinding="{Binding Id}" 
                                      DisplayMemberBinding="{Binding Nombre}"
                                      PlaceholderText="Seleccionar..."/>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <TextBlock Text="Estado" FontSize="10" Foreground="#aaa" Margin="0,0,0,4"/>
                            <ComboBox Width="120" SelectedIndex="{Binding FiltroEstadoIndex}">
                                <ComboBoxItem Content="Todos"/>
                                <ComboBoxItem Content="En Curso"/>
                                <ComboBoxItem Content="Finalizados"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="5">
                            <TextBlock Text="Rango de Fechas" FontSize="10" Foreground="#aaa" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <CalendarDatePicker SelectedDate="{Binding FiltroFechaDesde}" PlaceholderText="Desde"/>
                                <TextBlock Text="-" VerticalAlignment="Center" Foreground="#555"/>
                                <CalendarDatePicker SelectedDate="{Binding FiltroFechaHasta}" PlaceholderText="Hasta"/>
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>
            
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <TextBlock Text="Elementos por página:" VerticalAlignment="Center" FontSize="12" Foreground="#aaa"/>
                <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PageSizeConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <Grid>
                <DataGrid ItemsSource="{Binding Trabajos}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          x:CompileBindings="False"
                          GridLinesVisibility="All"
                          DoubleTapped="OnDataGridDoubleTapped"
                          IsVisible="{Binding !IsLoading}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre, Mode=OneWay}" />
                        <DataGridTextColumn Header="Inicio" Binding="{Binding FechaInicio, StringFormat=\{0:dd/MM/yyyy\}, Mode=OneWay}" />
                        <DataGridTextColumn Header="Presupuesto" Binding="{Binding Presupuesto, StringFormat=\{0:C\}, Mode=OneWay}" />
                        <DataGridCheckBoxColumn Header="Finalizado" Binding="{Binding Finalizado, Mode=OneWay}" />
                    </DataGrid.Columns>
                </DataGrid>

                <controls:ListStateOverlay IsLoading="{Binding IsLoading}"
                                           IsEmpty="{Binding IsEmpty}"
                                           HasError="{Binding HasError}"
                                           ErrorMessage="{Binding ErrorMessage}"
                                           RetryCommand="{Binding LoadTrabajosCommand}" />
            </Grid>
        </DockPanel>

        <!-- Overlay de Edición — ocupa toda el área disponible -->
        <ContentControl Content="{Binding EditViewModel}"
                        IsVisible="{Binding IsEditing}"
                        Focusable="True"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
</UserControl>
