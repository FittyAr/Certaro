<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ElectroObraApp.ViewModels"
             xmlns:controls="clr-namespace:ElectroObraApp.Controls"
             xmlns:loc="using:ElectroObraApp.Markup"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="ElectroObraApp.Views.MovimientosView"
             x:DataType="vm:MovimientosViewModel">
    <Grid>
        <DockPanel Margin="20" IsVisible="{Binding !IsEditing}">
            <controls:PageHeader DockPanel.Dock="Top"
                                 Title="{loc:Translate Key=Movements.Title}">
                <controls:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{loc:Translate Key=General.Add}" Classes="eo-primary" Command="{Binding AddCommand}" />
                        <Button Content="{loc:Translate Key=General.Refresh}" Classes="eo-secondary" Command="{Binding LoadMovimientosCommand}" />
                        <Button Content="{loc:Translate Key=General.Export}" Classes="eo-secondary">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{loc:Translate Key=Movements.ExportPdf}" Command="{Binding ExportPdfCommand}" />
                                    <MenuItem Header="{loc:Translate Key=Movements.ExportExcel}" Command="{Binding ExportExcelCommand}" />
                                    <MenuItem Header="{loc:Translate Key=Movements.ExportWord}" Command="{Binding ExportWordCommand}" />
                                    <MenuItem Header="{loc:Translate Key=Movements.ExportCsv}" Command="{Binding ExportCsvCommand}" />
                                    <MenuItem Header="{loc:Translate Key=Movements.ExportJson}" Command="{Binding ExportJsonCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <controls:FilterBar DockPanel.Dock="Top"
                                Header="{loc:Translate Key=Movements.SearchFilters}"
                                Margin="0,0,0,16">
                <controls:FilterBar.FilterContent>
                    <StackPanel Spacing="10">
                        <Button HorizontalAlignment="Right"
                                Content="{loc:Translate Key=General.ClearFilters}"
                                Classes="link"
                                Command="{Binding LimpiarFiltrosCommand}" />
                        <WrapPanel Orientation="Horizontal" Margin="-5">
                            <StackPanel Margin="5">
                                <TextBlock Text="{loc:Translate Key=Movements.Concept}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}" />
                                <TextBox Width="180" Text="{Binding FiltroConcepto}" PlaceholderText="{loc:Translate Key=General.Search}" />
                            </StackPanel>
                            <StackPanel Margin="5">
                                <TextBlock Text="{loc:Translate Key=Movements.Type}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}" />
                                <ComboBox Width="140"
                                          ItemsSource="{Binding TiposMovimiento}"
                                          SelectedValue="{Binding FiltroTipoId}"
                                          SelectedValueBinding="{Binding Id}"
                                          DisplayMemberBinding="{Binding Nombre}"
                                          PlaceholderText="{loc:Translate Key=General.Select}" />
                            </StackPanel>
                            <StackPanel Margin="5">
                                <TextBlock Text="{loc:Translate Key=Movements.DateFrom}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}" />
                                <CalendarDatePicker SelectedDate="{Binding FiltroFechaDesde}" PlaceholderText="{loc:Translate Key=General.From}" Width="140" />
                            </StackPanel>
                            <StackPanel Margin="5">
                                <TextBlock Text="{loc:Translate Key=Movements.DateTo}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}" />
                                <CalendarDatePicker SelectedDate="{Binding FiltroFechaHasta}" PlaceholderText="{loc:Translate Key=General.To}" Width="140" />
                            </StackPanel>
                            <StackPanel Margin="5">
                                <TextBlock Text="{loc:Translate Key=Movements.MinAmount}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}" />
                                <NumericUpDown Width="110" Value="{Binding FiltroMontoMin}" FormatString="C0" PlaceholderText="{loc:Translate Key=Movements.Min}" />
                            </StackPanel>
                            <StackPanel Margin="5">
                                <TextBlock Text="{loc:Translate Key=Movements.MaxAmount}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}" />
                                <NumericUpDown Width="110" Value="{Binding FiltroMontoMax}" FormatString="C0" PlaceholderText="{loc:Translate Key=Movements.Max}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </controls:FilterBar.FilterContent>
            </controls:FilterBar>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <controls:PaginationControl CurrentPage="{Binding CurrentPage}"
                                            TotalPages="{Binding TotalPages}"
                                            PreviousCommand="{Binding PreviousPageCommand}"
                                            NextCommand="{Binding NextPageCommand}"
                                            IsVisible="{Binding ShowPagination}" />
                <TextBlock Text="{loc:Translate Key=General.ItemsPerPage}" Classes="pageSizeLabel" Foreground="{DynamicResource TextTertiary}" />
                <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PageSizeConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <Grid>
                <DataGrid ItemsSource="{Binding Movimientos}"
                          Classes="eo-grid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          x:CompileBindings="False"
                          DoubleTapped="OnDataGridDoubleTapped"
                          IsVisible="{Binding !IsLoading}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Translate Key=Movements.Concept}" Binding="{Binding Concepto, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="{loc:Translate Key=Movements.Type}" Binding="{Binding TipoMovimientoNombre, Mode=OneWay}" />
                        <DataGridTextColumn Header="{loc:Translate Key=Movements.Date}" Binding="{Binding Fecha, StringFormat=\{0:dd/MM/yyyy\}, Mode=OneWay}" />
                        <DataGridTextColumn Header="{loc:Translate Key=Movements.Amount}" Binding="{Binding Monto, StringFormat=\{0:C\}, Mode=OneWay}" />
                        <DataGridTextColumn Header="{loc:Translate Key=Movements.Quantity}" Binding="{Binding Cantidad, Mode=OneWay}" />
                        <DataGridTextColumn Header="{loc:Translate Key=Movements.Total}" Binding="{Binding Total, StringFormat=\{0:C\}, Mode=OneWay}" />
                    </DataGrid.Columns>
                </DataGrid>
                <controls:ListStateOverlay IsLoading="{Binding IsLoading}"
                                           IsEmpty="{Binding IsEmpty}"
                                           HasError="{Binding HasError}"
                                           ErrorMessage="{Binding ErrorMessage}"
                                           RetryCommand="{Binding LoadMovimientosCommand}" />
            </Grid>
        </DockPanel>

        <Border Background="{DynamicResource OverlayBackgroundBrush}" IsVisible="{Binding IsEditing}" Focusable="True">
            <ContentControl Content="{Binding EditViewModel}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
