<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ElectroObraApp.ViewModels"
             xmlns:views="clr-namespace:ElectroObraApp.Views"
             xmlns:controls="clr-namespace:ElectroObraApp.Controls"
             xmlns:loc="using:ElectroObraApp.Markup"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="ElectroObraApp.Views.ClientesView"
             x:DataType="vm:ClientesViewModel">
    <Grid>
        <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="20">
            <TabItem Header="{loc:Translate Key=Clients.ListTab}">
                <DockPanel IsVisible="{Binding !IsEditing}">
                    <controls:PageHeader DockPanel.Dock="Top" Title="{loc:Translate Key=Clients.Title}">
                        <controls:PageHeader.Actions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Translate Key=General.Add}" Classes="eo-primary" Command="{Binding AddCommand}" />
                                <Button Content="{loc:Translate Key=General.Refresh}" Classes="eo-secondary" Command="{Binding LoadClientesCommand}" />
                            </StackPanel>
                        </controls:PageHeader.Actions>
                    </controls:PageHeader>

                    <controls:FilterBar DockPanel.Dock="Top"
                                        Header="{loc:Translate Key=Clients.SearchFilters}"
                                        Margin="0,0,0,16">
                        <controls:FilterBar.FilterContent>
                            <StackPanel Spacing="10">
                                <Button HorizontalAlignment="Right"
                                        Content="{loc:Translate Key=General.ClearFilters}"
                                        Classes="link"
                                        Command="{Binding LimpiarFiltrosCommand}" />
                                <WrapPanel Orientation="Horizontal" Margin="-5">
                                    <StackPanel Margin="5">
                                        <TextBlock Text="{loc:Translate Key=Clients.NameCuit}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}" />
                                        <TextBox Width="200" Text="{Binding FiltroNombre}" PlaceholderText="{loc:Translate Key=General.Search}" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </controls:FilterBar.FilterContent>
                    </controls:FilterBar>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                        <TextBlock Text="{loc:Translate Key=General.ItemsPerPage}" Classes="pageSizeLabel" Foreground="{DynamicResource TextTertiary}" />
                        <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource PageSizeConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <Grid>
                        <DataGrid ItemsSource="{Binding Clientes}"
                                  Classes="eo-grid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  x:CompileBindings="False"
                                  DoubleTapped="OnDataGridDoubleTapped"
                                  IsVisible="{Binding !IsLoading}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Translate Key=Clients.Name}" Binding="{Binding Nombre, Mode=OneWay}" Width="*" />
                                <DataGridTextColumn Header="{loc:Translate Key=Clients.Cuit}" Binding="{Binding Cuit, Mode=OneWay}" />
                                <DataGridTextColumn Header="{loc:Translate Key=Clients.Phone}" Binding="{Binding Telefono, Mode=OneWay}" />
                                <DataGridTemplateColumn Header="{loc:Translate Key=Clients.Email}" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="5,0">
                                                <TextBlock Text="{Binding Email}" VerticalAlignment="Center" />
                                                <Button Command="{Binding $parent[UserControl].((vm:ClientesViewModel)DataContext).OpenEmailCommand}"
                                                        CommandParameter="{Binding Email}"
                                                        Padding="4" Background="Transparent" BorderThickness="0"
                                                        ToolTip.Tip="{loc:Translate Key=Clients.SendEmail}">
                                                    <PathIcon Data="M20,4H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V6C22,4.9,21.1,4,20,4z M20,18H4V8l8,5l8,-5V18z M12,11L4,6h16L12,11z"
                                                              Width="14" Height="14" Foreground="{DynamicResource AccentBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{loc:Translate Key=Clients.TaxCondition}" Binding="{Binding CondicionIva, Mode=OneWay}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <controls:ListStateOverlay IsLoading="{Binding IsLoading}"
                                                   IsEmpty="{Binding IsEmpty}"
                                                   HasError="{Binding HasError}"
                                                   ErrorMessage="{Binding ErrorMessage}"
                                                   RetryCommand="{Binding LoadClientesCommand}" />
                    </Grid>
                </DockPanel>
            </TabItem>
            <TabItem Header="{loc:Translate Key=Clients.CurrentAccountTab}">
                <views:CuentaCorrienteView DataContext="{Binding CuentaCorrienteViewModel}" />
            </TabItem>
        </TabControl>

        <Border Background="{DynamicResource OverlayBackgroundBrush}" IsVisible="{Binding IsEditing}" Focusable="True">
            <ContentControl Content="{Binding EditViewModel}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>
