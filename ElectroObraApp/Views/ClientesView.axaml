<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ElectroObraApp.ViewModels"
             xmlns:controls="clr-namespace:ElectroObraApp.Controls"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:loc="using:ElectroObraApp.Markup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ElectroObraApp.Views.ClientesView"
             x:DataType="vm:ClientesViewModel">
    <Grid>
        <DockPanel Margin="20" IsVisible="{Binding !IsEditing}">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                    <TextBlock Text="Clientes" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Content="Agregar" Classes="accent" Command="{Binding AddCommand}" />
                    <Button Content="Refrescar" Command="{Binding LoadClientesCommand}" />
                </StackPanel>
            </Grid>

            <Border DockPanel.Dock="Top" Classes="filterPanel" Margin="0,0,0,20">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,5">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Filter" Width="16" Height="16" Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBlock Text="{loc:Translate Key=Clients.SearchFilters}" Classes="filterTitle"/>
                        </StackPanel>
                        <Button Grid.Column="1" HorizontalAlignment="Right" Content="{loc:Translate Key=General.ClearFilters}" Classes="link" Command="{Binding LimpiarFiltrosCommand}" FontSize="11"/>
                    </Grid>

                    <WrapPanel Orientation="Horizontal" Margin="-5">
                        <StackPanel Margin="5">
                            <TextBlock Text="Nombre / CUIT" FontSize="10" Foreground="#aaa" Margin="0,0,0,4"/>
                            <TextBox Width="200" Text="{Binding FiltroNombre}" PlaceholderText="Buscar..."/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>
            
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <TextBlock Text="Elementos por página:" VerticalAlignment="Center" FontSize="12" Foreground="#aaa"/>
                <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PageSizeConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <Grid>
                <DataGrid ItemsSource="{Binding Clientes}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          x:CompileBindings="False"
                          GridLinesVisibility="All"
                          DoubleTapped="OnDataGridDoubleTapped"
                          IsVisible="{Binding !IsLoading}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="CUIT" Binding="{Binding Cuit, Mode=OneWay}" />
                        <DataGridTextColumn Header="Teléfono" Binding="{Binding Telefono, Mode=OneWay}" />
                        <DataGridTemplateColumn Header="Email" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="5,0">
                                        <TextBlock Text="{Binding Email}" VerticalAlignment="Center"/>
                                        <Button Command="{Binding $parent[UserControl].((vm:ClientesViewModel)DataContext).OpenEmailCommand}" 
                                                CommandParameter="{Binding Email}"
                                                Padding="4" Background="Transparent" BorderThickness="0"
                                                ToolTip.Tip="Enviar Correo">
                                            <PathIcon Data="M20,4H4C2.9,4,2,4.9,2,6v12c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V6C22,4.9,21.1,4,20,4z M20,18H4V8l8,5l8,-5V18z M12,11L4,6h16L12,11z" 
                                                      Width="14" Height="14" Foreground="{DynamicResource AccentBrush}"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Cond. IVA" Binding="{Binding CondicionIva, Mode=OneWay}" />
                    </DataGrid.Columns>
                </DataGrid>

                <controls:ListStateOverlay IsLoading="{Binding IsLoading}"
                                           IsEmpty="{Binding IsEmpty}"
                                           HasError="{Binding HasError}"
                                           ErrorMessage="{Binding ErrorMessage}"
                                           RetryCommand="{Binding LoadClientesCommand}" />
            </Grid>
        </DockPanel>

        <!-- Overlay de Edición -->
        <Border Background="#AA000000" IsVisible="{Binding IsEditing}" Focusable="True">
            <ContentControl Content="{Binding EditViewModel}" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>

