<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ElectroObraApp.ViewModels"
             xmlns:loc="using:ElectroObraApp.Markup"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="ElectroObraApp.Views.FacturasView"
             x:DataType="vm:FacturasViewModel">
    <Grid>
        <DockPanel Margin="20" IsVisible="{Binding !IsEditing}">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left">
                    <TextBlock Text="{loc:Translate Key=Invoices.Title}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Content="{loc:Translate Key=General.Add}" Classes="accent" Command="{Binding AddCommand}" />
                    <Button Content="{loc:Translate Key=General.Refresh}" Command="{Binding LoadFacturasCommand}" />
                </StackPanel>
            </Grid>

            <Border DockPanel.Dock="Top" Background="#252525" CornerRadius="8" Padding="15" Margin="0,0,0,20" BorderBrush="#3d3d3d" BorderThickness="1">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="{loc:Translate Key=Invoices.SearchFilters}" FontSize="12" FontWeight="Bold" Foreground="#888" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" HorizontalAlignment="Right" Content="{loc:Translate Key=General.ClearFilters}" Classes="link" Command="{Binding LimpiarFiltrosCommand}" FontSize="11"/>
                    </Grid>
                    <StackPanel>
                        <TextBlock Text="{loc:Translate Key=Invoices.NumberClient}" FontSize="10" Foreground="#aaa" Margin="0,0,0,4"/>
                        <TextBox Width="250" Text="{Binding FiltroNumero}" PlaceholderText="{loc:Translate Key=General.Search}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <TextBlock Text="{loc:Translate Key=General.ItemsPerPage}" VerticalAlignment="Center" FontSize="12" Foreground="#aaa"/>
                <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PageSizeConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Facturas}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      x:CompileBindings="False"
                      DoubleTapped="OnDataGridDoubleTapped">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Translate Key=Invoices.Number}" Binding="{Binding Numero, Mode=OneWay}" Width="120"/>
                    <DataGridTextColumn Header="{loc:Translate Key=Movements.Date}" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy', Mode=OneWay}" Width="110"/>
                    <DataGridTextColumn Header="{loc:Translate Key=Jobs.Client}" Binding="{Binding ClienteNombre, Mode=OneWay}" Width="*"/>
                    <DataGridTextColumn Header="{loc:Translate Key=Invoices.Status}" Binding="{Binding Estado, Mode=OneWay}" Width="100"/>
                    <DataGridTextColumn Header="{loc:Translate Key=Invoices.Subtotal}" Binding="{Binding Subtotal, StringFormat='C', Mode=OneWay}" Width="110"/>
                    <DataGridTextColumn Header="{loc:Translate Key=Invoices.Iva}" Binding="{Binding Iva, StringFormat='C', Mode=OneWay}" Width="100"/>
                    <DataGridTextColumn Header="{loc:Translate Key=Movements.Total}" Binding="{Binding Total, StringFormat='C', Mode=OneWay}" Width="110"/>
                    <DataGridTemplateColumn Header="{loc:Translate Key=General.Delete}" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{loc:Translate Key=General.Delete}"
                                        Command="{Binding $parent[UserControl].((vm:FacturasViewModel)DataContext).DeleteCommand}"
                                        CommandParameter="{Binding}"
                                        Classes="danger"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Background="#AA000000" IsVisible="{Binding IsEditing}">
            <ContentControl Content="{Binding EditViewModel}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
