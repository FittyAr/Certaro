<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ElectroObraApp.ViewModels"
             xmlns:controls="clr-namespace:ElectroObraApp.Controls"
             xmlns:loc="using:ElectroObraApp.Markup"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="500"
             x:Class="ElectroObraApp.Views.FacturasView"
             x:DataType="vm:FacturasViewModel">
    <controls:MasterDetailLayout>
        <controls:MasterDetailLayout.Master>
        <DockPanel>
            <controls:PageHeader DockPanel.Dock="Top" Title="{loc:Translate Key=Invoices.Title}">
                <controls:PageHeader.Actions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="{loc:Translate Key=General.Add}" Classes="eo-primary" Command="{Binding AddCommand}" />
                        <Button Content="{loc:Translate Key=General.Refresh}" Classes="eo-secondary" Command="{Binding LoadFacturasCommand}" />
                    </StackPanel>
                </controls:PageHeader.Actions>
            </controls:PageHeader>

            <controls:FilterBar DockPanel.Dock="Top"
                                Header="{loc:Translate Key=Invoices.SearchFilters}">
                <controls:FilterBar.FilterContent>
                    <StackPanel Spacing="10">
                        <Button HorizontalAlignment="Right"
                                Content="{loc:Translate Key=General.ClearFilters}"
                                Classes="link"
                                Command="{Binding LimpiarFiltrosCommand}" />
                        <StackPanel>
                            <TextBlock Text="{loc:Translate Key=Invoices.NumberClient}" Classes="filterLabel" Foreground="{DynamicResource TextTertiary}" />
                            <TextBox Width="250" Text="{Binding FiltroNumero}" PlaceholderText="{loc:Translate Key=General.Search}" />
                        </StackPanel>
                    </StackPanel>
                </controls:FilterBar.FilterContent>
            </controls:FilterBar>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <TextBlock Text="{loc:Translate Key=General.ItemsPerPage}" Classes="pageSizeLabel" Foreground="{DynamicResource TextTertiary}" />
                <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource PageSizeConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <Grid>
                <DataGrid ItemsSource="{Binding Facturas}"
                          Classes="eo-grid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          x:CompileBindings="False"
                          DoubleTapped="OnDataGridDoubleTapped"
                          IsVisible="{Binding !IsLoading}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Translate Key=Invoices.Number}" Binding="{Binding Numero, Mode=OneWay}" Width="120" />
                        <DataGridTextColumn Header="{loc:Translate Key=Movements.Date}" Binding="{Binding Fecha, StringFormat='dd/MM/yyyy', Mode=OneWay}" Width="110" />
                        <DataGridTextColumn Header="{loc:Translate Key=Jobs.Client}" Binding="{Binding ClienteNombre, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="{loc:Translate Key=Invoices.Status}" Binding="{Binding Estado, Mode=OneWay}" Width="100" />
                        <DataGridTextColumn Header="{loc:Translate Key=Invoices.Subtotal}" Binding="{Binding Subtotal, StringFormat='C', Mode=OneWay}" Width="110" />
                        <DataGridTextColumn Header="{loc:Translate Key=Invoices.Iva}" Binding="{Binding Iva, StringFormat='C', Mode=OneWay}" Width="100" />
                        <DataGridTextColumn Header="{loc:Translate Key=Movements.Total}" Binding="{Binding Total, StringFormat='C', Mode=OneWay}" Width="110" />
                        <DataGridTemplateColumn Header="{loc:Translate Key=General.Delete}" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{loc:Translate Key=General.Delete}"
                                            Command="{Binding $parent[UserControl].((vm:FacturasViewModel)DataContext).DeleteCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="danger" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <controls:ListStateOverlay IsLoading="{Binding IsLoading}"
                                           IsEmpty="{Binding IsEmpty}"
                                           HasError="{Binding HasError}"
                                           ErrorMessage="{Binding ErrorMessage}"
                                           RetryCommand="{Binding LoadFacturasCommand}" />
            </Grid>
        </DockPanel>
        </controls:MasterDetailLayout.Master>

        <controls:MasterDetailLayout.Detail>
        <Border Background="{DynamicResource SurfaceRaised}"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius12}"
                MinWidth="320">
            <Grid>
                <ContentControl Content="{Binding EditViewModel}" IsVisible="{Binding IsEditing}" />
                <controls:EmptyState IsVisible="{Binding !IsEditing}"
                                     IconKind="Receipt"
                                     Title="{loc:Translate Key=Invoices.Title}"
                                     Description="{loc:Translate Key=General.SelectRecordHint}"
                                     ActionText="{loc:Translate Key=General.Add}"
                                     ActionCommand="{Binding AddCommand}" />
            </Grid>
        </Border>
        </controls:MasterDetailLayout.Detail>
    </controls:MasterDetailLayout>
</UserControl>
