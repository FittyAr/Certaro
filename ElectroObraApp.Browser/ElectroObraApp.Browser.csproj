<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElectroObraApp\ElectroObraApp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ElectroObraApp.Desktop\ServiceConfiguration.cs" Link="ServiceConfiguration.cs" />
    <None Include="..\ElectroObraApp\Assets\i18n\*.json" Link="Assets\i18n\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>

