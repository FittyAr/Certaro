# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
.eslintcache
.stylelintcache
coverage/
.nyc_output/
*.tsbuildinfo

# Package manager artifacts (pnpm is the supported manager)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

