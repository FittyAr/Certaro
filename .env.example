# PrimeUI license key for primevue 5.x (removes the dev-time "Invalid PrimeUI License" overlay).
#
# Preferred (one time per repo, covers every PC with `gh auth login` — no .env sync needed):
#   gh variable set PRIMEUI_KEY --body "<your-key>"
# vite.config.ts then fetches it automatically and caches it into .env.local (gitignored).
#
# CI also accepts it as a GitHub secret named PRIMEUI_KEY.
VITE_PRIMEUI_LICENSE_KEY=
